{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifactum.example/schema/goal_package.json",
  "title": "Proficio Goal Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "tenant_id",
    "requested_capability",
    "inputs"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "goal_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "matter_id": {"type": ["string", "null"]},
    "requested_capability": {"type": "string", "minLength": 1},
    "requested_mode": {"enum": ["DIRECT", "GUIDED", "ESCALATED", "FORGE", null]},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string"},
          "ref": {"type": "string"},
          "provenance": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "constraints": {"type": "object"},
    "desired_outputs": {"type": "array", "items": {"type": "string"}},
    "risk_hints": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
